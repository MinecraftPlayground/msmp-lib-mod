{
  "schemaVersion": 1,
  "id": "msmp-lib",
  "version": "${version}",
  "name": "MSMP Lib",
  "description": "This Minecraft Fabric Mod Extends the Minecraft Server Management Protocol (MSMP).",
  "authors": [],
  "contact": {},
  "license": "LGPL-3.0-only",
  "icon": "assets/icon.png",
  "environment": "server",
  "entrypoints": {},
  "mixins": [
    "msmp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "mc-publish": {
      "modrinth": {
        "project_id": "---",
        "loaders": [
          "fabric"
        ]
      }
    }
  }
}
